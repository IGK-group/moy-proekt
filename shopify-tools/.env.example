# Твой магазин (см. shopify-tools/PLAYBOOK.md - там реальные значения для MebelShop)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_PASTE_YOUR_TOKEN_HERE
SHOPIFY_API_VERSION=2024-01

# Магазин-донор (откуда берём товары и цены)
SOURCE_STORE_DOMAIN=donor-store.com

# Скидка от цены донора (0.90 = -10%, 0.85 = -15%)
DISCOUNT=0.90

# Остаток на складе для дропшиппинга
TARGET_AVAILABLE=22

# ID локации склада (найдётся автоматически если 0)
SHOPIFY_LOCATION_ID=0

# Нужны только для get_token.py (переполучение токена через OAuth)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_AUTH_REDIRECT=http://localhost:3456/callback
