{% comment %}
  GlideHome Product (PDP) — страница товара для темы GlideHome REDESIGN.
  Данные тянутся из товара Shopify. Контент (фото, описание, спеки) — Гена
  наполняет в админке товара. См. UX-ANALYSIS.md раздел PDP.
{% endcomment %}

{{ 'glide-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glide-home.js' | asset_url }}" defer></script>

{%- assign p = product -%}
{%- assign cv = p.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if cv.compare_at_price > cv.price -%}{%- assign on_sale = true -%}{%- endif -%}

<section class="glide glide-pdp" data-glide-pdp {{ section.shopify_attributes }}>
  <div class="glide-wrap glide-pdp-top">

    {%- comment -%} ---------- ГАЛЕРЕЯ ---------- {%- endcomment -%}
    <div class="glide-pdp-gallery">
      <div class="glide-pdp-main">
        {%- if p.featured_image -%}
          <img data-glide-pdp-main src="{{ p.featured_image | image_url: width: 1200 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="1200" height="1200">
        {%- endif -%}
      </div>
      {%- if p.images.size > 1 -%}
        <div class="glide-pdp-thumbs">
          {%- for img in p.images limit: 8 -%}
            <button type="button" class="glide-pdp-thumb{% if forloop.first %} is-on{% endif %}" data-glide-pdp-thumb
              data-full="{{ img | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 180 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- ИНФО / ПОКУПКА ---------- {%- endcomment -%}
    <div class="glide-pdp-info">
      {%- if p.type != blank -%}<span class="glide-eyebrow">{{ p.type }}</span>{%- endif -%}
      <h1 class="glide-pdp-title">{{ p.title }}</h1>

      <div class="glide-pdp-rating" aria-label="Rating">
        <span class="glide-pdp-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="glide-pdp-rating-txt">Be the first to review</span>
      </div>

      <div class="glide-pdp-price">
        <span class="glide-pdp-now" data-glide-pdp-price>{{ cv.price | money }}</span>
        {%- if on_sale -%}
          {%- assign pct = cv.compare_at_price | minus: cv.price | times: 100.0 | divided_by: cv.compare_at_price | round -%}
          <span class="glide-pdp-was" data-glide-pdp-compare>{{ cv.compare_at_price | money }}</span>
          <span class="glide-pdp-save">&minus;{{ pct }}%</span>
        {%- endif -%}
      </div>

      {%- if p.description contains '<ul>' -%}
        {%- assign intro = p.description | split: '<ul>' | first | strip_html | strip | truncatewords: 40 -%}
        {%- if intro != blank -%}<p class="glide-pdp-intro">{{ intro }}</p>{%- endif -%}
      {%- endif -%}

      {%- form 'product', p, class: 'glide-pdp-form', novalidate: 'novalidate' -%}
        {%- unless p.has_only_default_variant -%}
          <div class="glide-pdp-options">
            {%- for opt in p.options_with_values -%}
              <label class="glide-pdp-opt">
                <span class="glide-pdp-opt-name">{{ opt.name }}</span>
                <select name="options[{{ opt.name | escape }}]" data-glide-pdp-opt>
                  {%- for val in opt.values -%}
                    <option value="{{ val | escape }}"{% if opt.selected_value == val %} selected{% endif %}>{{ val }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <input type="hidden" name="id" data-glide-pdp-id value="{{ cv.id }}">
        <button type="submit" class="glide-btn glide-btn--primary glide-btn--lg glide-pdp-atc"
          data-glide-pdp-atc {% unless cv.available %}disabled{% endunless %}>
          <span>{% if cv.available %}Add to cart{% else %}Sold out{% endif %}</span>
        </button>

        <script type="application/json" data-glide-pdp-variants>
          [{% for v in p.variants %}{"id":{{ v.id }},"available":{{ v.available }},"price":{{ v.price | json }},"compare":{{ v.compare_at_price | json }},"options":{{ v.options | json }},"img":{{ v.featured_image.src | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        </script>
      {%- endform -%}

      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="glide-pdp-trust">
          <span class="glide-trust-item"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg> Secure checkout</span>
          <span class="glide-trust-item"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4h9v7H1z"/><path d="M10 6h3l2 2v3h-5z"/><circle cx="4" cy="12.5" r="1.3"/><circle cx="12" cy="12.5" r="1.3"/></svg> Free shipping</span>
          <span class="glide-trust-item"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8a5 5 0 0 1 8-4l2 2M13 8a5 5 0 0 1-8 4l-2-2"/><path d="M13 2v4h-4M3 14v-4h4"/></svg> 30-day returns</span>
          <span class="glide-pdp-pay">{{ shop.enabled_payment_types | payment_type_svg_tag: class: 'glide-pay-ico' }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- ОПИСАНИЕ (body_html товара) ---------- {%- endcomment -%}
  {%- if p.description != blank -%}
    <div class="glide-wrap glide-wrap--narrow glide-pdp-body rte">
      {{ p.description }}
    </div>
  {%- endif -%}

  {%- comment -%} ---------- ПОХОЖИЕ ---------- {%- endcomment -%}
  {%- assign rel = p.collections | where: 'handle', section.settings.related_collection | first -%}
  {%- unless rel -%}{%- assign rel = p.collections.first -%}{%- endunless -%}
  {%- if rel and rel.products.size > 1 -%}
    <div class="glide-wrap glide-pdp-related">
      <div class="glide-sec-head glide-sec-head--row"><div><span class="glide-eyebrow">More from GlideHome</span><h2>You might also like</h2></div></div>
      <div class="glide-lineup-grid">
        {%- for rp in rel.products limit: 4 -%}
          {%- if rp.id != p.id -%}
            <a class="glide-pcard" href="{{ rp.url }}">
              <div class="glide-pcard-art">
                {%- if rp.compare_at_price > rp.price -%}
                  {%- assign rpct = rp.compare_at_price | minus: rp.price | times: 100.0 | divided_by: rp.compare_at_price | round -%}
                  <span class="glide-pcard-badge">&minus;{{ rpct }}%</span>
                {%- endif -%}
                {%- if rp.featured_image -%}<img src="{{ rp.featured_image | image_url: width: 700 }}" alt="{{ rp.title | escape }}" loading="lazy">{%- endif -%}
              </div>
              <div class="glide-pcard-body">
                <h3>{{ rp.title }}</h3>
                <div class="glide-pcard-meta">
                  <span class="glide-pcard-price">{% if rp.price_varies %}From {% endif %}{{ rp.price | money }}</span>
                  {%- if rp.compare_at_price > rp.price -%}<span class="glide-pcard-was">{{ rp.compare_at_price | money }}</span>{%- endif -%}
                </div>
                <span class="glide-pcard-cta">View details</span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "GlideHome Product",
  "tag": "section",
  "class": "glide-pdp-section",
  "settings": [
    { "type": "text", "id": "related_collection", "label": "Related products from collection (handle)", "info": "Leave blank to use the product's first collection" }
  ],
  "presets": [{ "name": "GlideHome Product" }]
}
{% endschema %}
