{% comment %}
  GlideHome FAQ — аккордеон. Роль в скелете ECOVACS: FAQ.
  Контент — реальные вопросы по товарам магазина + доставка/возврат.
  Тумблер «View all / Show less»: первые N открыты, остальные скрыты.
{% endcomment %}

{{ 'glide-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glide-home.js' | asset_url }}" defer></script>

<section class="glide glide-faq" data-glide-faq {{ section.shopify_attributes }}>
  <div class="glide-wrap glide-wrap--narrow">
    <div class="glide-sec-head">
      {%- if section.settings.eyebrow != blank -%}<span class="glide-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="glide-faq-list">
      {%- assign visible = section.settings.visible_count -%}
      {%- for block in section.blocks -%}
        {%- assign s = block.settings -%}
        <details class="glide-faq-item{% if forloop.index > visible %} is-extra{% endif %}"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ s.q }}</span>
            <span class="glide-faq-chev" aria-hidden="true">+</span>
          </summary>
          <div class="glide-faq-a">{{ s.a }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > visible -%}
      <button class="glide-faq-toggle" type="button" data-glide-faq-toggle
        data-more="{{ section.settings.more_label }}" data-less="{{ section.settings.less_label }}">
        {{ section.settings.more_label }}
      </button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GlideHome FAQ",
  "tag": "section",
  "class": "glide-faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions people ask before buying" },
    { "type": "range", "id": "visible_count", "label": "Shown before 'view all'", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "text", "id": "more_label", "label": "Expand label", "default": "View all questions" },
    { "type": "text", "id": "less_label", "label": "Collapse label", "default": "Show less" }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ] }
  ],
  "max_blocks": 20,
  "presets": [{
    "name": "GlideHome FAQ",
    "blocks": [
      { "type": "qa", "settings": { "q": "Which window robot should I get?", "a": "<p>The <strong>W17S</strong> ($129.99) is for flat indoor glass — windows, mirrors, shower doors, glass tables. The <strong>DYP</strong> ($269.99) adds a UPS backup battery and a safety rope, so it's the one for tall, floor-to-ceiling or exterior windows.</p>" } },
      { "type": "qa", "settings": { "q": "Will it fall off the glass?", "a": "<p>Strong suction holds the robot on vertical glass, and edge sensors make it turn before the frame. The DYP goes further: a built-in UPS keeps suction alive through a power cut, and a safety rope is included.</p>" } },
      { "type": "qa", "settings": { "q": "What surfaces do the window robots work on?", "a": "<p>Flat glass: windows, mirrors, shower doors and glass tabletops. Minimum window size for the DYP is 35 × 35 cm.</p>" } },
      { "type": "qa", "settings": { "q": "How long does a window take?", "a": "<p>The DYP cleans at about 0.23 m²/min — a standard window is done in a few minutes. Press start and walk away.</p>" } },
      { "type": "qa", "settings": { "q": "Do the robot vacuums really mop?", "a": "<p>Yes. Both vacuums sweep, suction and mop in one automatic pass. The 3-in-1 has a 300 ml tank; the Ultra-Thin has an auto-refill reservoir that keeps the pad wet for the whole cycle.</p>" } },
      { "type": "qa", "settings": { "q": "Will the vacuum fit under my furniture?", "a": "<p>The Ultra-Thin model is built low on purpose — it slides under sofas, beds and cabinets where dust collects. It covers up to 150 m² on one 4,400 mAh charge.</p>" } },
      { "type": "qa", "settings": { "q": "How are they powered?", "a": "<p>Window robots run on mains power (the DYP is 100–240V and works worldwide). Robot vacuums charge over USB or a dock and run 60–120 minutes per charge.</p>" } },
      { "type": "qa", "settings": { "q": "Shipping, returns and warranty?", "a": "<p>Free shipping on every order, delivered in 5–11 business days. 30-day returns, no questions asked, plus a 2-year warranty on every GlideHome device.</p>" } }
    ]
  }]
}
{% endschema %}
