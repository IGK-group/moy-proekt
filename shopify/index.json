    "glide_faq": {
      "type": "glide-faq",
      "settings": {
        "eyebrow": "Good to know",
        "heading": "Questions people ask before buying",
        "visible_count": 5,
        "more_label": "View all questions",
        "less_label": "Show less"
      },
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Which window robot should I get?",
            "a": "<p>The <strong>W17S</strong> ($129.99) is for flat indoor glass — windows, mirrors, shower doors, glass tables. The <strong>DYP</strong> ($269.99) adds a UPS backup battery and a safety rope, so it's the one for tall, floor-to-ceiling or exterior windows.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Will it fall off the glass?",
            "a": "<p>Strong suction holds the robot on vertical glass, and edge sensors make it turn before the frame. The DYP goes further: a built-in UPS keeps suction alive through a power cut, and a safety rope is included.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "What surfaces do the window robots work on?",
            "a": "<p>Flat glass: windows, mirrors, shower doors and glass tabletops. Minimum window size for the DYP is 35 × 35 cm.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "How long does a window take?",
            "a": "<p>The DYP cleans at about 0.23 m²/min — a standard window is done in a few minutes. Press start and walk away.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Do the robot vacuums really mop?",
            "a": "<p>Yes. Both vacuums sweep, suction and mop in one automatic pass. The 3-in-1 has a 300 ml tank; the Ultra-Thin has an auto-refill reservoir that keeps the pad wet for the whole cycle.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Will the vacuum fit under my furniture?",
            "a": "<p>The Ultra-Thin model is built low on purpose — it slides under sofas, beds and cabinets where dust collects. It covers up to 150 m² on one 4,400 mAh charge.</p>"
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "How are they powered?",
            "a": "<p>Window robots run on mains power (the DYP is 100–240V and works worldwide). Robot vacuums charge over USB or a dock and run 60–120 minutes per charge.</p>"
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "q": "Shipping, returns and warranty?",
            "a": "<p>Free shipping on every order, delivered in 5–11 business days. 30-day returns, no questions asked, plus a 2-year warranty on every GlideHome device.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6",
        "q7",
        "q8"
      ]
    },
