    "glide_innovations": {
      "type": "glide-innovations",
      "settings": {
        "eyebrow": "GlideHome technology",
        "heading": "What makes the clean reliable"
      },
      "blocks": {
        "f1": {
          "type": "feature",
          "settings": {
            "icon": "safety",
            "eyebrow": "Triple fall-safety",
            "title": "Stays on the glass even if the power drops",
            "text": "A suction turbine, a built-in UPS battery and a safety rope in the box. Pull the plug and the DYP keeps its grip and lowers gently instead of falling."
          }
        },
        "f2": {
          "type": "feature",
          "settings": {
            "icon": "edge",
            "eyebrow": "Edge detection",
            "title": "Cleans right up to the frame",
            "text": "Perimeter sensors map the window's edges. The robot turns before the frame and leaves no dirty strip along the border."
          }
        },
        "f3": {
          "type": "feature",
          "settings": {
            "icon": "route",
            "eyebrow": "Smart path planning",
            "title": "Full coverage, not random circles",
            "text": "Robot vacuums map the room and clean in an efficient pattern; window robots run three cleaning patterns plus a finishing pass along the edges."
          }
        },
        "f4": {
          "type": "feature",
          "settings": {
            "icon": "three",
            "eyebrow": "3-in-1 in one pass",
            "title": "Sweeps, vacuums and mops together",
            "text": "One automatic cycle does all three. Auto water refill keeps the mop pad wet from start to finish, up to 150 m² per charge."
          }
        }
      },
      "block_order": [
        "f1",
