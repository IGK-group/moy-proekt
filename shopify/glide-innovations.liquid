{% comment %}
  GlideHome Innovations — чередующиеся блоки фич с появлением на скролле.
  Роль в скелете ECOVACS: раздел Innovations. Контент — реальные фичи товаров.
{% endcomment %}

{{ 'glide-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glide-home.js' | asset_url }}" defer></script>

<section class="glide glide-innov" {{ section.shopify_attributes }}>
  <div class="glide-wrap">
    <div class="glide-sec-head">
      {%- if section.settings.eyebrow != blank -%}<span class="glide-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="glide-innov-stats glide-reveal">
        {%- for block in stat_blocks -%}
          <div class="glide-innov-stat" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type != 'feature' -%}{%- continue -%}{%- endif -%}
      {%- assign s = block.settings -%}
      <div class="glide-feature glide-reveal" {{ block.shopify_attributes }}>
        <div class="glide-feature-media">
          {%- if s.image != blank -%}
            <img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.title | escape }}" loading="lazy">
          {%- else -%}
            <span class="glide-feature-ico" aria-hidden="true">
              {%- case s.icon -%}
                {%- when 'app' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="20" y="6" width="24" height="52" rx="5"/><path d="M20 46h24"/><circle cx="32" cy="52" r="1.5"/><path d="M26 22h12M26 30h12M26 38h7"/></svg>
                {%- when 'sparkle' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M32 10v14M32 40v14M10 32h14M40 32h14"/><path d="m18 18 8 8M38 38l8 8M46 18l-8 8M26 38l-8 8"/></svg>
                {%- when 'safety' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M32 6 12 14v14c0 14 8 22 20 28 12-6 20-14 20-28V14Z"/><path d="m24 32 6 6 12-12"/></svg>
                {%- when 'edge' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="10" width="44" height="44" rx="6"/><path d="M10 24h44M24 10v44" stroke-dasharray="4 5"/><circle cx="32" cy="32" r="4"/></svg>
                {%- when 'route' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16h36M50 16c0 9-36 5-36 16s36 7 36 16M14 48h36"/></svg>
                {%- when 'three' -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="22" cy="24" r="10"/><circle cx="42" cy="24" r="10"/><circle cx="32" cy="42" r="10"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="32" r="24"/><path d="m22 32 7 7 14-14"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
        </div>
        <div class="glide-feature-text">
          {%- if s.eyebrow != blank -%}<span class="glide-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.title != blank -%}<h3>{{ s.title }}</h3>{%- endif -%}
          {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
          {%- if s.bullets != blank -%}
            <ul class="glide-feature-list">
              {%- assign rows = s.bullets | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}{%- assign r = row | strip -%}{%- if r != '' -%}
                {%- assign parts = r | split: ' — ' -%}
                {%- if parts.size > 1 -%}<li><b>{{ parts[0] }}</b> — {{ parts | slice: 1, 10 | join: ' — ' }}</li>{%- else -%}<li>{{ r }}</li>{%- endif -%}
              {%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GlideHome Innovations",
  "tag": "section",
  "class": "glide-innov-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it actually performs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You run it from your phone. It does the rest." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "150 m²" },
        { "type": "text", "id": "label", "label": "Label", "default": "per charge" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (if no image)", "options": [
          { "value": "app", "label": "App / phone" },
          { "value": "route", "label": "Route / path" },
          { "value": "sparkle", "label": "Results / sparkle" },
          { "value": "safety", "label": "Shield / safety" },
          { "value": "edge", "label": "Edge / frame" },
          { "value": "three", "label": "3-in-1" },
          { "value": "check", "label": "Check" }
        ], "default": "check" },
        { "type": "image_picker", "id": "image", "label": "Image (optional, overrides icon)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "textarea", "id": "bullets", "label": "Bullets — one per line (lead word before an em-dash is bolded)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{
    "name": "GlideHome Innovations",
    "blocks": [
      { "type": "stat", "settings": { "value": "150 m²", "label": "cleaned per charge" } },
      { "type": "stat", "settings": { "value": "0.23 m²/min", "label": "window cleaning speed" } },
      { "type": "stat", "settings": { "value": "3 + 1", "label": "patterns, then an edge pass" } },
      { "type": "stat", "settings": { "value": "5-11 days", "label": "free delivery" } },
      { "type": "feature", "settings": { "icon": "app", "eyebrow": "GlideHome app", "title": "Watch it work from your phone", "text": "Live map with the robot's position and path, a fill-in progress bar, schedules and no-go zones. Start it from the office, come home to it done." } },
      { "type": "feature", "settings": { "icon": "route", "eyebrow": "Proven coverage", "title": "A planned path into every corner", "text": "It maps the room first, then cleans in tight even rows that reach the walls, wrap the furniture legs and go under the sofa - not random circles that miss half the floor." } },
      { "type": "feature", "settings": { "icon": "sparkle", "eyebrow": "Real results", "title": "Glass without streaks, floors you'd walk barefoot on", "text": "Microfibre and a measured water flow lift grease and grime in one pass. The difference between the cleaned strip and the rest is the whole point." } },
      { "type": "feature", "settings": { "icon": "safety", "eyebrow": "Triple fall-safety", "title": "Stays on the glass even if the power drops", "text": "A suction turbine, a built-in UPS battery and a safety rope in the box. Pull the plug and the DYP keeps its grip and lowers gently instead of falling." } }
    ]
  }]
}
{% endschema %}
